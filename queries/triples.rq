PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
SELECT ?film ?shot ?story ?shotCountry WHERE {
  ?film wdt:P31/wdt:P279* wd:Q11424 .
  ?film wdt:P915 ?shot .
  ?film wdt:P840 ?story .
  FILTER(?shot != ?story)
  OPTIONAL { ?shot wdt:P17 ?shotCountry }
}
